            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "available_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
