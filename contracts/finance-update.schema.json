        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "record": {
          "$ref": "#/$defs/Commitment"
        }
      }
    },
    "upsert_aid": {
