    "upsert_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "event_id",
        "effective_date",
        "record"
      ],
      "properties": {
        "operation": {
          "const": "upsert_support"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "record": {
          "$ref": "#/$defs/Support"
        }
      }
    },
    "set_source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "event_id",
        "effective_date",
        "money_source_id",
        "accessible",
        "restrictions"
      ],
      "properties": {
        "operation": {
