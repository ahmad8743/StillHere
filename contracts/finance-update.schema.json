        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "original_event_id": {
          "type": "string",
          "minLength": 1
        },
        "balance_effect": {
          "enum": [
            "adjust_source",
            "already_reflected"
          ]
        }
      }
    },
    "refresh_balance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "event_id",
        "effective_date",
        "money_source_id",
        "balance_cents",
        "reflected_event_ids"
      ],
      "properties": {
        "operation": {
          "const": "refresh_balance"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "money_source_id": {
          "type": "string",
          "minLength": 1
        },
        "balance_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reflected_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "upsert_money_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "event_id",
        "effective_date",
        "record"
      ],
      "properties": {
        "operation": {
          "const": "upsert_money_source"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "record": {
          "$ref": "#/$defs/MoneySource"
        }
