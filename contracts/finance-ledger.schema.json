{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stillhere:finance-ledger:0.1-draft",
  "$comment": "P2 proposed persisted ledger. References, unique IDs, date ordering and reconciliation are additionally enforced by the module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "money_sources",
    "actual_events",
    "expense_commitments"
  ],
  "properties": {
    "money_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoneySource"
      }
    },
    "actual_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActualEvent"
      }
    },
    "expense_commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Commitment"
      }
    },
    "aid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Aid"
      }
    },
    "support": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Support"
      }
    },
    "record_updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecordUpdate"
      }
    }
