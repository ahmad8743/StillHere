    "UpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "changed_record_ids",
        "reconciliation_notes",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "applied",
            "already_applied",
            "needs_clarification",
            "rejected"
          ]
        },
        "ledger": {
          "$comment": "Rejected invalid-ledger inputs are returned unchanged and are never safe to persist."
        },
        "changed_record_ids": {
          "type": "array",
