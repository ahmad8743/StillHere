            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "date"
          ]
        },
        {
          "required": [
            "start_date",
            "end_date"
          ]
        },
        {
          "required": [
            "day"
          ]
        },
        {
          "required": [
            "start_day",
            "end_day"
          ]
        }
      ],
      "dependentRequired": {
        "start_date": [
          "end_date"
        ],
        "end_date": [
          "start_date"
        ],
        "start_day": [
          "end_day"
        ],
        "end_day": [
          "start_day"
        ]
      }
    },
    "Aid": {
