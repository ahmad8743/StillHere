# Copy this blank template to .env.local. Never commit or attach .env.local.
# Use an accessible tool-capable Bedrock model or inference profile; no model is assumed.
AWS_REGION=
STILLHERE_BEDROCK_MODEL_ID=

# Prefer AWS_PROFILE/role credentials, or fill these for a local temporary session.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

STILLHERE_AGENT_MAX_TURNS=4
STILLHERE_AGENT_MAX_TOOL_CALLS=6
STILLHERE_AGENT_MAX_OUTPUT_TOKENS=1024
STILLHERE_AGENT_MAX_TOTAL_TOKENS=12000
STILLHERE_AGENT_TIMEOUT_SECONDS=60
STILLHERE_AGENT_HISTORY_TURNS=12
STILLHERE_AGENT_MAX_CONTEXT_CHARS=48000
# The first slice enables read_case and correct_fact. Enable tested intake separately.
STILLHERE_AGENT_ENABLE_INTAKE=false
# C03 public sources need no additional credentials. Enable the incident tool separately.
STILLHERE_AGENT_ENABLE_INCIDENTS=false
